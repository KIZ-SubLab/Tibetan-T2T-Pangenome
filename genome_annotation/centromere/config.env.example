# ============================================================
# Centromere core pipeline - configuration
# Copy to config.env and edit. No real server paths are stored here.
# ============================================================

# --- shared ---
THREADS=8
WORKDIR=/path/to/workdir

# --- reference / annotation (provided externally or by APGp1 collaborator) ---
ASSEMBLY_DIR=/path/to/haplotype_assemblies          # *.fasta (+ .fai)
CENANNO_DIR=/path/to/cenanno                        # APGp1 monomer/HOR annotation
HORCLASS_DIR=/path/to/horclass                      # HOR classification BED
CENTROMERE_BED=/path/to/centromere_intervals.bed    # per-haplotype centromere intervals
SATELLITE_BED=/path/to/satellite_annotation.bed     # RepeatMasker-derived satellite BED

# --- software ---
REPEATMASKER=RepeatMasker
REPEATMASKER_VERSION=4.1.6
MERYL=meryl
MAFFT=mafft
MINIMAP2=minimap2
BEAST=beast
TREEANNOTATOR=treeannotator

# --- k-mer ---
KMER_SIZE=15                     # canonical 15-mers
ARCHAIC_MIN_COUNT=2              # meryl greater-than 2  -> count >= 3
AFR_MIN_COUNT=9                  # meryl greater-than 9  -> count >= 10
ARC_WINDOW=2000                  # 2-kbp non-overlapping windows
ARC_SIGNAL_MIN=11                # >= 11 archaic-specific k-mers per window

# --- SNV projection ---
SNV_MAPQ_MIN=30
SNV_COV_MIN=0.85

# --- sequence comparison ---
SEQ_WINDOW=20000
SEQ_STEP=1000
SEQ_MAPQ_MIN=5
SEQ_MIN_ALIGN_LEN=5000
SEQ_MIN_IDENTITY=85

# --- phylogeny ---
FLANK_WINDOW=50000
MAFFT_THREADS=32
BEAST_CHAIN=50000000
BEAST_LOG_EVERY=1000
BEAST_STORE_EVERY=5000
BEAST_BURNIN_FRAC=0.10

# --- archaic datasets (name -> R1/R2 or single) ---
ARCHAIC_DATASETS="altai vindija chagyrskaya denisova3 denisova25"
RULER_TAXON=''  # Set to a taxon with a gap-free alignment row.
